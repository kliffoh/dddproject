# ─────────────────────────────────────────────────────────────
#  DDD AI Workforce v6 — configuration
#  Copy to .env (the hosting scripts do this for you).
# ─────────────────────────────────────────────────────────────

# Network
PORT=8765
HOST=0.0.0.0
# Set to 1 when running behind Caddy / nginx / Cloudflare / Render / Fly
TRUST_PROXY=0
# Public URL people use (e.g. https://workforce.example.com)
PUBLIC_URL=
# Extra origins allowed to call the API (comma-separated), e.g. a Netlify site
ALLOWED_ORIGINS=

# Data location — set an ABSOLUTE path when running as a service
DDD_DATA_DIR=

# Capacity
DDD_MAX_EMPLOYEES=550
# Per-IP flood guards (an office of 550 often shares one public IP)
RATE_API_BURST=6000
RATE_API_PER_SEC=300
RATE_LOGIN_BURST=700
RATE_LOGIN_PER_SEC=15

# Security
SESSION_TTL_HOURS=12
# Set only to recover the developer account; it is re-applied on every start
SUPER_ADMIN_ID=DEV-001
SUPER_ADMIN_PASS=
# Seed demo accounts on a brand-new database (1 = yes, 0 = no)
DDD_SEED_DEMO=1

# Monitoring
INACTIVITY_MIN=45
BACKUP_EVERY_HOURS=1
BACKUP_KEEP=48

# AI (optional) — enables generative answers grounded on the knowledge base
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
